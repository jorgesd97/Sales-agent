# Plantilla. Copiar a `.env` para correr en local (`.env` está gitignoreado).
# En el despliegue estos valores van como variables de entorno del servicio.
# NUNCA poner credenciales reales en este archivo: SÍ se commitea.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt5mini-dodo
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embeddings-dodo

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<servicio>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX_NAME=dodo-knowledge-base

# --- Supabase: memoria + promociones (aún sin migrar) ---
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=
POSTGRES_CONNECTION_STRING=postgresql://user:password@host:6543/postgres

# --- Defaults ---
DEFAULT_MATCH_COUNT=3

# --- API ---
AGENT_API_KEY=
